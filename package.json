{
	"name": "@natoboram/goodenough",
	"version": "0.0.0",
	"description": "Rate anything.",
	"keywords": [
		"rate",
		"review",
		"score"
	],
	"homepage": "https://github.com/NatoBoram/GoodEnough",
	"bugs": {
		"url": "https://github.com/NatoBoram/GoodEnough/issues"
	},
	"license": "AGPL-3.0-or-later",
	"author": {
		"name": "Nato Boram",
		"url": "https://github.com/NatoBoram"
	},
	"funding": [
		{
			"type": "patreon",
			"url": "https://www.patreon.com/NatoBoram"
		},
		{
			"type": "individual",
			"url": "https://paypal.me/NatoBoram/5"
		}
	],
	"files": [
		"build"
	],
	"type": "module",
	"bin": {
		"goodenough": "build/index.js"
	},
	"repository": "github:NatoBoram/GoodEnough",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && markdownlint-cli2 \"**/*.md\" && prettier --check .",
		"lint:fix": "eslint --fix --quiet .; markdownlint-cli2 \"**/*.md\" --fix; prettier --list-different --write .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"db": "kysely",
		"db:start": "docker compose up --detach --force-recreate --remove-orphans",
		"db:stop": "docker compose down --remove-orphans",
		"db:generate": "kysely-codegen --dialect postgres --env-file .env.local --out-file src/lib/server/db/kysely-codegen.ts --singularize",
		"db:migrate": "kysely migrate:latest",
		"db:migrate:up": "kysely migrate:up",
		"db:migrate:down": "kysely migrate:down",
		"db:migrate:make": "kysely migrate:make",
		"db:reset": "docker compose down; docker volume rm goodenough_goodenough-postgres",
		"db:regenerate": "pnpm run db:reset && pnpm run db:start && sleep 10 && pnpm run db:migrate && pnpm run db:generate && pnpm run dev",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.sql --adapter kysely --dialect postgresql --yes",
		"sync": "svelte-kit sync"
	},
	"devDependencies": {
		"@better-auth/kysely-adapter": "^1.7.2",
		"@chromatic-com/storybook": "latest",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@natoboram/heroicons.svelte": "^1.2.1",
		"@natoboram/load_env": "^2.0.3",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/sveltekit": "^10.5.10",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"auth": "^1.7.2",
		"better-auth": "^1.7.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.10",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"kysely": "^0.29.5",
		"kysely-codegen": "^0.20.0",
		"kysely-ctl": "^0.21.0",
		"markdownlint-cli2": "^0.23.2",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.60.0",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-sql-cst": "^0.22.1",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"storybook": "^10.5.10",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
